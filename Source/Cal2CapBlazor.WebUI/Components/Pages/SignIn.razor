@page "/sign-in"
@rendermode InteractiveServer

@using MediatR
@using Cal2CapBlazor.Domain.Common
@using Cal2CapBlazor.Application.Accounts.Queries
@using Cal2CapBlazor.Infrastructure.Services

@inject IMediator Mediator
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="container col-md-4 mt-5">
    <div class="card p-4 shadow-sm">
        <h3 class="card-title text-center mb-4">Welcome Back</h3>

        <EditForm Model="@_model" OnValidSubmit="HandleLogin" FormName="LoginForm">
            <div class="mb-3">
                <label class="form-label">Email Address</label>
                <InputText @bind-Value="_model.Email" class="form-control" type="email" />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <InputText @bind-Value="_model.Password" class="form-control" type="password" />
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger">@_errorMessage</div>
            }

            <button type="submit" class="btn btn-primary w-100 mb-3" disabled="@_isSubmitting">
                @(_isSubmitting ? "Authenticating..." : "Sign In")
            </button>

            <div class="text-center">
                <a href="/sign-up" class="text-decoration-none">New around here? Create an account</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    public class LoginFormModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    private LoginFormModel _model = new LoginFormModel();
    private string? _errorMessage;
    private bool _isSubmitting;

    private async Task HandleLogin()
    {
        _isSubmitting = true;
        _errorMessage = null;

        SignInQuery command = new SignInQuery(_model.Email, _model.Password);
        Result result = await Mediator.Send(command);

        if (result.IsSuccess)
        {
            Navigation.NavigateTo("/dashboard");
        }
        else
        {
            _errorMessage = result.Error.Message;
        }

        _isSubmitting = false;
    }
}