@page "/sign-up"
@rendermode InteractiveServer

@using Cal2CapBlazor.Domain.Common;
@using Cal2CapBlazor.Application.Accounts.Commands

@inject IMediator Mediator
@inject NavigationManager Navigation

<div class="container col-md-4 mt-5">
    <div class="card p-4 shadow-sm">
        <h3 class="card-title text-center mb-4">Create Account</h3>

        <EditForm Model="@_model" OnValidSubmit="HandleRegister" FormName="RegisterForm">
            <div class="mb-3">
                <label class="form-label">Display Name</label>
                <InputText @bind-Value="_model.DisplayName" class="form-control" placeholder="John Doe" />
            </div>

            <div class="mb-3">
                <label class="form-label">Email Address</label>
                <InputText @bind-Value="_model.EmailAddress" class="form-control" type="email" placeholder="name@example.com" />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <InputText @bind-Value="_model.Password" class="form-control" type="password" placeholder="Min 8 characters" />
            </div>

            <div class="mb-3">
                <label class="form-label">Confirm Password</label>
                <InputText @bind-Value="_model.ConfirmPassword" class="form-control" type="password" placeholder="Min 8 characters" />
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger">@_errorMessage</div>
            }

            <button type="submit" class="btn btn-success w-100 mb-3" disabled="@_isSubmitting">
                @(_isSubmitting ? "Registering..." : "Sign Up")
            </button>
            
            <div class="text-center">
                <a href="/sign-in" class="text-decoration-none">Already have an account? Sign In</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    public class SignUpFormModel
    {
        public string DisplayName { get; set; } = string.Empty;
        public string EmailAddress { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private SignUpFormModel _model = new SignUpFormModel();
    private string? _errorMessage;
    private bool _isSubmitting;

    private async Task HandleRegister()
    {
        _isSubmitting = true;
        _errorMessage = null;

        CreateAccountCommand createCommand = new CreateAccountCommand(
            _model.DisplayName, 
            _model.EmailAddress, 
            _model.Password,
            _model.ConfirmPassword);

        Result result = await Mediator.Send(createCommand);
        if (result.IsSuccess)
        {
            Navigation.NavigateTo("/sign-in");
        }
        else
        {
            _errorMessage = result.Error.Message;
        }

        _isSubmitting = false;
    }
}