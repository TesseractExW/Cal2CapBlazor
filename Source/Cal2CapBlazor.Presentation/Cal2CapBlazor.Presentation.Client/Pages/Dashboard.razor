@page "/dashboard"
@rendermode InteractiveWebAssembly

@using System.Text.Json
@using Cal2CapBlazor.Presentation.Client.DataTransferObjects
@inject NavigationManager Navigation
@inject HttpClient Http

<PageTitle>Cal2Cap | Dashboard</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8 min-h-screen">
            
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 gap-6">
                <div>
                    <h2 class="text-emerald-950 text-3xl font-bold mb-1" style="font-family: 'Playfair Display', serif;">Your Nutrition Journey</h2>
                    <p class="text-stone-500 text-sm tracking-wide" style="font-family: 'Montserrat', sans-serif;">Manage your daily fuel and track your holistic caps.</p>
                </div>
                
                <div class="flex flex-col md:flex-row md:items-center justify-items-start gap-4 w-full md:w-auto">
                    <div class="flex items-center gap-1 bg-stone-200/70 p-1 rounded-sm flex-grow md:flex-grow-0" style="font-family: 'Montserrat', sans-serif;">
                        <button @onclick="() => IsCompactView = true" class="@(IsCompactView ? "bg-stone-50 shadow-sm text-emerald-950" : "text-stone-500 hover:text-emerald-950") flex-1 md:flex-none px-4 py-2 text-[0.65rem] font-bold uppercase tracking-widest transition-all rounded-sm">
                            Compact
                        </button>
                        <button @onclick="() => IsCompactView = false" class="@(!IsCompactView ? "bg-stone-50 shadow-sm text-emerald-950" : "text-stone-500 hover:text-emerald-950") flex-1 md:flex-none px-4 py-2 text-[0.65rem] font-bold uppercase tracking-widest transition-all rounded-sm">
                            Detailed
                        </button>
                    </div>

                    <button @onclick="OpenAddModal" class="bg-emerald-950 text-stone-50 px-6 py-2 h-full text-xs font-bold uppercase tracking-widest hover:bg-emerald-800 transition-colors rounded-sm shadow-md flex items-center justify-center gap-2 flex-shrink-0" style="font-family: 'Montserrat', sans-serif;">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                        Log Meal
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(GlobalError))
            {
                <div class="bg-red-50/50 border-l-4 border-red-600 p-4 mb-8 rounded-r-sm flex justify-between items-center">
                    <p class="text-red-700 text-sm font-medium" style="font-family: 'Montserrat', sans-serif;">@GlobalError</p>
                    <button @onclick="() => GlobalError = null" class="text-red-700 hover:text-red-900"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
                </div>
            }

            @if (PagedResponse != null)
            {
                <div class="@(IsCompactView ? "grid grid-cols-1 md:grid-cols-2 gap-4" : "grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6") mb-10">
                    @foreach (var meal in PagedResponse.Items)
                    {
                        @if (IsCompactView)
                        {
                            <div class="bg-stone-50 border border-stone-200 p-4 rounded-sm shadow-sm hover:shadow-md transition-shadow relative group flex justify-between items-center">
                                <div>
                                    <h3 class="text-emerald-950 text-base font-bold" style="font-family: 'Playfair Display', serif;">@meal.MealName</h3>
                                    <div class="flex items-center gap-3 mt-1.5">
                                        <p class="text-stone-400 text-[0.65rem] uppercase tracking-wider" style="font-family: 'Montserrat', sans-serif;">@meal.InTakeTime.ToLocalTime().ToString("MMM dd - hh:mm tt")</p>
                                        <div class="flex gap-1.5">
                                            @foreach (var tag in GetActiveTags(meal.MealType))
                                            {
                                                <span class="px-1.5 py-0.5 text-[0.6rem] uppercase tracking-wider font-bold rounded-sm @GetTagStyle(tag)">@tag</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="opacity-0 group-hover:opacity-100 transition-opacity flex gap-1">
                                    <button @onclick="() => OpenViewModal(meal)" class="text-emerald-700 hover:text-emerald-900 bg-emerald-50 hover:bg-emerald-100 p-2 rounded-full transition-colors">
                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                    </button>
                                    <button @onclick="() => DeleteMeal(meal.Id)" class="text-red-600 hover:text-red-800 bg-red-50 hover:bg-red-100 p-2 rounded-full transition-colors">
                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="bg-stone-50 border border-stone-200 p-6 rounded-sm shadow-sm hover:shadow-md transition-shadow relative group">
                                <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity flex gap-2">
                                    <button @onclick="() => OpenViewModal(meal)" class="text-emerald-700 hover:text-emerald-900 bg-emerald-50 hover:bg-emerald-100 p-2 rounded-full transition-colors">
                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                    </button>
                                    <button @onclick="() => DeleteMeal(meal.Id)" class="text-red-600 hover:text-red-800 bg-red-50 hover:bg-red-100 p-2 rounded-full transition-colors">
                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    </button>
                                </div>

                                <div class="mb-4">
                                    <h3 class="text-emerald-950 text-xl font-bold pr-16" style="font-family: 'Playfair Display', serif;">@meal.MealName</h3>
                                    <p class="text-stone-500 text-xs mt-1">@meal.InTakeTime.ToLocalTime().ToString("MMM dd, yyyy - hh:mm tt")</p>
                                </div>
                                
                                <p class="text-stone-600 text-sm mb-4 line-clamp-2" style="font-family: 'Montserrat', sans-serif;">@meal.MealDetails</p>

                                <div class="flex flex-wrap gap-2 mb-4">
                                    @foreach (var tag in GetActiveTags(meal.MealType))
                                    {
                                        <span class="px-2 py-1 text-[0.65rem] uppercase tracking-wider font-bold rounded-sm @GetTagStyle(tag)">@tag</span>
                                    }
                                </div>

                                <div class="flex flex-wrap gap-2 border-t border-stone-200 pt-4" style="font-family: 'Montserrat', sans-serif;">
                                    @if(meal.Calorie > 0) { <div class="bg-orange-50 text-orange-800 px-2 py-1 rounded-sm text-xs font-bold border border-orange-100">@meal.Calorie kcal</div> }
                                    @if(meal.Protein > 0) { <div class="bg-rose-50 text-rose-800 px-2 py-1 rounded-sm text-xs font-bold border border-rose-100">@meal.Protein g Pro</div> }
                                    @if(meal.Carbohydrate > 0) { <div class="bg-sky-50 text-sky-800 px-2 py-1 rounded-sm text-xs font-bold border border-sky-100">@meal.Carbohydrate g Carb</div> }
                                    @if(meal.Fat > 0) { <div class="bg-amber-50 text-amber-800 px-2 py-1 rounded-sm text-xs font-bold border border-amber-100">@meal.Fat g Fat</div> }
                                    @if(meal.Calcium > 0) { <div class="bg-indigo-50 text-indigo-800 px-2 py-1 rounded-sm text-xs font-bold border border-indigo-100">@meal.Calcium mg Ca</div> }
                                    @if(meal.Iron > 0) { <div class="bg-red-50 text-red-800 px-2 py-1 rounded-sm text-xs font-bold border border-red-100">@meal.Iron mg Fe</div> }
                                    @if(meal.Magnesium > 0) { <div class="bg-purple-50 text-purple-800 px-2 py-1 rounded-sm text-xs font-bold border border-purple-100">@meal.Magnesium mg Mg</div> }
                                    @if(meal.Zinc > 0) { <div class="bg-cyan-50 text-cyan-800 px-2 py-1 rounded-sm text-xs font-bold border border-cyan-100">@meal.Zinc mg Zn</div> }
                                    @if(meal.VitaminC > 0) { <div class="bg-emerald-50 text-emerald-800 px-2 py-1 rounded-sm text-xs font-bold border border-emerald-100">@meal.VitaminC mg Vit C</div> }
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="flex justify-between items-center border-t border-stone-200 pt-6" style="font-family: 'Montserrat', sans-serif;">
                    <p class="text-sm text-stone-500">Showing page <span class="font-bold">@CurrentPage</span> of <span class="font-bold">@PagedResponse.TotalPage</span></p>
                    <div class="flex gap-2">
                        <button disabled="@(CurrentPage == 1)" @onclick="PrevPage" class="px-4 py-2 bg-stone-200 text-emerald-950 text-xs font-bold uppercase disabled:opacity-50 hover:bg-stone-300 transition-colors rounded-sm shadow-sm">Prev</button>
                        <button disabled="@(CurrentPage >= PagedResponse.TotalPage)" @onclick="NextPage" class="px-4 py-2 bg-stone-200 text-emerald-950 text-xs font-bold uppercase disabled:opacity-50 hover:bg-stone-300 transition-colors rounded-sm shadow-sm">Next</button>
                    </div>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                    @for(int i=0; i<6; i++) { <div class="h-24 bg-stone-200 animate-pulse rounded-sm"></div> }
                </div>
            }
        </div>

        @if (IsAddModalOpen)
        {
            <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-emerald-950/40 backdrop-blur-sm overflow-y-auto">
                <div class="bg-stone-50 w-full max-w-lg rounded-sm shadow-2xl p-6 md:p-8 relative mt-10 mb-10" style="font-family: 'Montserrat', sans-serif;">
                    <button @onclick="CloseModals" class="absolute top-4 right-4 text-stone-400 hover:text-emerald-950"><svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
                    
                    <h3 class="text-2xl font-bold text-emerald-950 mb-6" style="font-family: 'Playfair Display', serif;">Log New Meal</h3>

                    <div class="space-y-4">
                        <div class="flex flex-col space-y-1">
                            <label class="text-[0.65rem] font-bold text-stone-500 uppercase tracking-widest">Name</label>
                            <input @bind="NewMealModel.MealName" class="bg-stone-50 border border-stone-300 px-3 py-2 text-sm focus:outline-none focus:border-emerald-950 rounded-sm shadow-inner" placeholder="e.g. Morning Oatmeal" />
                        </div>
                        
                        <div class="flex flex-col space-y-1">
                            <label class="text-[0.65rem] font-bold text-stone-500 uppercase tracking-widest">Intake Time</label>
                            <input type="datetime-local" @bind="NewMealModel.InTakeTime" class="bg-stone-50 border border-stone-300 px-3 py-2 text-sm focus:outline-none focus:border-emerald-950 rounded-sm shadow-inner" />
                        </div>

                        <div class="flex flex-col space-y-1">
                            <label class="text-[0.65rem] font-bold text-stone-500 uppercase tracking-widest">Details</label>
                            <textarea @bind="NewMealModel.MealDetails" rows="2" class="bg-stone-50 border border-stone-300 px-3 py-2 text-sm focus:outline-none focus:border-emerald-950 rounded-sm shadow-inner" placeholder="Notes or ingredients..."></textarea>
                        </div>

                        <div class="pt-2">
                            <label class="text-[0.65rem] font-bold text-stone-500 uppercase tracking-widest block mb-2">Meal Tags</label>
                            <div class="flex flex-wrap gap-2">
                                @foreach (var type in AvailableMealTypes)
                                {
                                    bool isChecked = (NewMealModel.MealType & type.Value) == type.Value;
                                    <label class="cursor-pointer border px-3 py-1 text-[0.65rem] font-bold uppercase tracking-wider rounded-sm transition-colors @(isChecked ? "bg-emerald-950 text-stone-50 border-emerald-950 shadow-md" : "bg-stone-50 text-stone-500 border-stone-300 hover:bg-stone-200")">
                                        <input type="checkbox" class="hidden" checked="@isChecked" @onchange="@(e => ToggleAddMealType(type.Value, e.Value))" />
                                        @type.Key
                                    </label>
                                }
                            </div>
                        </div>

                        <button @onclick="CreateMeal" class="w-full mt-6 bg-emerald-950 text-stone-50 px-4 py-3 text-sm font-bold uppercase tracking-widest hover:bg-emerald-800 transition-colors shadow-sm rounded-sm">
                            Save Meal
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (IsViewModalOpen && ViewingMeal != null)
        {
            <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-emerald-950/40 backdrop-blur-sm overflow-y-auto">
                <div class="bg-stone-50 w-full max-w-2xl rounded-sm shadow-2xl p-6 md:p-8 relative mt-10 mb-10" style="font-family: 'Montserrat', sans-serif;">
                    <button @onclick="CloseModals" class="absolute top-4 right-4 text-stone-400 hover:text-emerald-950"><svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
                    
                    @if (!IsEditingMode)
                    {
                        <div class="flex justify-between items-start mb-6">
                            <div>
                                <h3 class="text-3xl font-bold text-emerald-950" style="font-family: 'Playfair Display', serif;">
                                    @ViewingMeal.MealName
                                </h3>
                                <p class="text-sm text-stone-500 mt-1">@ViewingMeal.InTakeTime.ToLocalTime().ToString("MMMM dd, yyyy - hh:mm tt")</p>
                            </div>
                            <button @onclick="() => IsEditingMode = true" class="text-emerald-700 hover:text-emerald-900 bg-emerald-50 hover:bg-emerald-100 p-2 rounded-full transition-colors">
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                            </button>
                        </div>

                        <p class="text-stone-600 text-sm mb-6 leading-relaxed">@ViewingMeal.MealDetails</p>

                        <div class="flex flex-wrap gap-2 mb-8">
                            @foreach (var tag in GetActiveTags(ViewingMeal.MealType))
                            {
                                <span class="px-2 py-1 text-[0.65rem] uppercase tracking-wider font-bold rounded-sm @GetTagStyle(tag)">@tag</span>
                            }
                        </div>

                        <label class="text-[0.65rem] font-bold text-stone-500 uppercase tracking-widest block mb-4 border-b border-stone-200 pb-1">Nutrient Profile</label>
                        
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                            <div class="bg-stone-100 p-3 rounded-sm text-center border border-stone-200">
                                <p class="text-[0.65rem] text-stone-500 uppercase tracking-widest">Calories</p>
                                <p class="text-lg font-bold text-emerald-950">
                                    @(ViewingMeal.Calorie ?? 0) 
                                    <span class="text-xs font-normal">kcal</span>
                                </p>
                            </div>
                            <div class="bg-stone-100 p-3 rounded-sm text-center border border-stone-200">
                                <p class="text-[0.65rem] text-stone-500 uppercase tracking-widest">Carbs</p>
                                <p class="text-lg font-bold text-emerald-950">@(ViewingMeal.Carbohydrate ?? 0) 
                                    <span class="text-xs font-normal">g</span>
                                </p>
                            </div>
                            <div class="bg-stone-100 p-3 rounded-sm text-center border border-stone-200">
                                <p class="text-[0.65rem] text-stone-500 uppercase tracking-widest">Protein</p>
                                <p class="text-lg font-bold text-emerald-950">@(ViewingMeal.Protein ?? 0) 
                                    <span class="text-xs font-normal">g</span>
                                </p>
                            </div>
                            <div class="bg-stone-100 p-3 rounded-sm text-center border border-stone-200">
                                <p class="text-[0.65rem] text-stone-500 uppercase tracking-widest">Fat</p>
                                <p class="text-lg font-bold text-emerald-950">@(ViewingMeal.Fat ?? 0) 
                                    <span class="text-xs font-normal">g</span>
                                </p>
                            </div>
                            <div class="bg-stone-100 p-3 rounded-sm text-center border border-stone-200">
                                <p class="text-[0.65rem] text-stone-500 uppercase tracking-widest">Calcium</p>
                                <p class="text-lg font-bold text-emerald-950">@(ViewingMeal.Calcium ?? 0) 
                                    <span class="text-xs font-normal">mg</span>
                                </p>
                            </div>
                            <div class="bg-stone-100 p-3 rounded-sm text-center border border-stone-200">
                                <p class="text-[0.65rem] text-stone-500 uppercase tracking-widest">Iron</p>
                                <p class="text-lg font-bold text-emerald-950">@(ViewingMeal.Iron ?? 0) 
                                    <span class="text-xs font-normal">mg</span>
                                </p>
                            </div>
                            <div class="bg-stone-100 p-3 rounded-sm text-center border border-stone-200">
                                <p class="text-[0.65rem] text-stone-500 uppercase tracking-widest">Magnesium</p>
                                <p class="text-lg font-bold text-emerald-950">@(ViewingMeal.Magnesium ?? 0) 
                                    <span class="text-xs font-normal">mg</span>
                                </p>
                            </div>
                            <div class="bg-stone-100 p-3 rounded-sm text-center border border-stone-200">
                                <p class="text-[0.65rem] text-stone-500 uppercase tracking-widest">Zinc</p>
                                <p class="text-lg font-bold text-emerald-950">@(ViewingMeal.Zinc ?? 0) 
                                    <span class="text-xs font-normal">mg</span>
                                </p>
                            </div>
                            <div class="bg-stone-100 p-3 rounded-sm text-center border border-stone-200">
                                <p class="text-[0.65rem] text-stone-500 uppercase tracking-widest">Vit A</p>
                                <p class="text-lg font-bold text-emerald-950">@(ViewingMeal.VitaminA ?? 0) 
                                    <span class="text-xs font-normal">mcg</span>
                                </p>
                            </div>
                            <div class="bg-stone-100 p-3 rounded-sm text-center border border-stone-200">
                                <p class="text-[0.65rem] text-stone-500 uppercase tracking-widest">Vit B</p>
                                <p class="text-lg font-bold text-emerald-950">@(ViewingMeal.VitaminB ?? 0) 
                                    <span class="text-xs font-normal">mg</span>
                                </p>
                            </div>
                            <div class="bg-stone-100 p-3 rounded-sm text-center border border-stone-200">
                                <p class="text-[0.65rem] text-stone-500 uppercase tracking-widest">Vit C</p>
                                <p class="text-lg font-bold text-emerald-950">@(ViewingMeal.VitaminC ?? 0) 
                                    <span class="text-xs font-normal">mg</span>
                                </p>
                            </div>
                            <div class="bg-stone-100 p-3 rounded-sm text-center border border-stone-200">
                                <p class="text-[0.65rem] text-stone-500 uppercase tracking-widest">Vit D</p>
                                <p class="text-lg font-bold text-emerald-950">@(ViewingMeal.VitaminD ?? 0) 
                                    <span class="text-xs font-normal">mcg</span>
                                </p>
                            </div>
                            <div class="bg-stone-100 p-3 rounded-sm text-center border border-stone-200">
                                <p class="text-[0.65rem] text-stone-500 uppercase tracking-widest">Vit E</p>
                                <p class="text-lg font-bold text-emerald-950">@(ViewingMeal.VitaminE ?? 0) 
                                    <span class="text-xs font-normal">mg</span>
                                    </p>
                                </div>
                        </div>
                    }
                    else
                    {
                        <h3 class="text-2xl font-bold text-emerald-950 mb-2" style="font-family: 'Playfair Display', serif;">Refine Meal</h3>
                        <p class="text-xs text-stone-500 mb-6 uppercase tracking-widest">Adjust parameters seamlessly.</p>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div class="space-y-4">
                                <div class="flex flex-col space-y-1">
                                    <label class="text-[0.65rem] font-bold text-stone-500 uppercase tracking-widest">Name</label>
                                    <input @bind="ViewingMeal.MealName" class="bg-stone-50 border border-stone-300 px-3 py-2 text-sm focus:outline-none focus:border-emerald-950 rounded-sm shadow-inner" />
                                </div>

                                <div class="flex flex-col space-y-1">
                                    <label class="text-[0.65rem] font-bold text-stone-500 uppercase tracking-widest">Intake Time</label>
                                    <input type="datetime-local" @bind="ViewingMeal.InTakeTime" class="bg-stone-50 border border-stone-300 px-3 py-2 text-sm focus:outline-none focus:border-emerald-950 rounded-sm shadow-inner" />
                                </div>

                                <div class="flex flex-col space-y-1">
                                    <label class="text-[0.65rem] font-bold text-stone-500 uppercase tracking-widest">Details</label>
                                    <textarea @bind="ViewingMeal.MealDetails" rows="2" class="bg-stone-50 border border-stone-300 px-3 py-2 text-sm focus:outline-none focus:border-emerald-950 rounded-sm shadow-inner"></textarea>
                                </div>
                                
                                <div class="pt-2">
                                    <label class="text-[0.65rem] font-bold text-stone-500 uppercase tracking-widest block mb-2">Meal Tags</label>
                                    <div class="flex flex-wrap gap-2">
                                        @foreach (var type in AvailableMealTypes)
                                        {
                                            bool isChecked = (ViewingMeal.MealType & type.Value) == type.Value;
                                            <label class="cursor-pointer border px-2 py-1 text-[0.65rem] font-bold uppercase tracking-wider rounded-sm transition-colors @(isChecked ? "bg-emerald-950 text-stone-50 border-emerald-950 shadow-md" : "bg-stone-50 text-stone-500 border-stone-300 hover:bg-stone-200")">
                                                <input type="checkbox" class="hidden" checked="@isChecked" @onchange="@(e => ToggleEditMealType(type.Value, e.Value))" />
                                                @type.Key
                                            </label>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div>
                                <label class="text-[0.65rem] font-bold text-stone-500 uppercase tracking-widest block mb-3 border-b border-stone-200 pb-1">Nutrient Profile</label>
                                
                                <div class="grid grid-cols-2 gap-3 h-64 overflow-y-auto pr-2">
                                    <div class="flex flex-col space-y-1">
                                        <label class="text-xs text-stone-600">Calories (kcal)</label>
                                        <input type="number" @bind="ViewingMeal.Calorie" class="bg-stone-50 border border-stone-300 px-2 py-1.5 text-sm focus:outline-none focus:border-emerald-950 rounded-sm shadow-inner" />
                                    </div>
                                    <div class="flex flex-col space-y-1">
                                        <label class="text-xs text-stone-600">Carbs (g)</label>
                                        <input type="number" @bind="ViewingMeal.Carbohydrate" class="bg-stone-50 border border-stone-300 px-2 py-1.5 text-sm focus:outline-none focus:border-emerald-950 rounded-sm shadow-inner" />
                                    </div>
                                    <div class="flex flex-col space-y-1">
                                        <label class="text-xs text-stone-600">Protein (g)</label>
                                        <input type="number" @bind="ViewingMeal.Protein" class="bg-stone-50 border border-stone-300 px-2 py-1.5 text-sm focus:outline-none focus:border-emerald-950 rounded-sm shadow-inner" />
                                    </div>
                                    <div class="flex flex-col space-y-1">
                                        <label class="text-xs text-stone-600">Fat (g)</label>
                                        <input type="number" @bind="ViewingMeal.Fat" class="bg-stone-50 border border-stone-300 px-2 py-1.5 text-sm focus:outline-none focus:border-emerald-950 rounded-sm shadow-inner" />
                                    </div>
                                    <div class="flex flex-col space-y-1">
                                        <label class="text-xs text-stone-600">Calcium (mg)</label>
                                        <input type="number" @bind="ViewingMeal.Calcium" class="bg-stone-50 border border-stone-300 px-2 py-1.5 text-sm focus:outline-none focus:border-emerald-950 rounded-sm shadow-inner" />
                                    </div>
                                    <div class="flex flex-col space-y-1">
                                        <label class="text-xs text-stone-600">Iron (mg)</label>
                                        <input type="number" @bind="ViewingMeal.Iron" class="bg-stone-50 border border-stone-300 px-2 py-1.5 text-sm focus:outline-none focus:border-emerald-950 rounded-sm shadow-inner" />
                                    </div>
                                    <div class="flex flex-col space-y-1">
                                        <label class="text-xs text-stone-600">Magnesium (mg)</label>
                                        <input type="number" @bind="ViewingMeal.Magnesium" class="bg-stone-50 border border-stone-300 px-2 py-1.5 text-sm focus:outline-none focus:border-emerald-950 rounded-sm shadow-inner" />
                                    </div>
                                    <div class="flex flex-col space-y-1">
                                        <label class="text-xs text-stone-600">Zinc (mg)</label>
                                        <input type="number" @bind="ViewingMeal.Zinc" class="bg-stone-50 border border-stone-300 px-2 py-1.5 text-sm focus:outline-none focus:border-emerald-950 rounded-sm shadow-inner" />
                                    </div>
                                    <div class="flex flex-col space-y-1">
                                        <label class="text-xs text-stone-600">Vitamin A (mcg)</label>
                                        <input type="number" @bind="ViewingMeal.VitaminA" class="bg-stone-50 border border-stone-300 px-2 py-1.5 text-sm focus:outline-none focus:border-emerald-950 rounded-sm shadow-inner" />
                                    </div>
                                    <div class="flex flex-col space-y-1">
                                        <label class="text-xs text-stone-600">Vitamin B (mg)</label>
                                        <input type="number" @bind="ViewingMeal.VitaminB" class="bg-stone-50 border border-stone-300 px-2 py-1.5 text-sm focus:outline-none focus:border-emerald-950 rounded-sm shadow-inner" />
                                    </div>
                                    <div class="flex flex-col space-y-1">
                                        <label class="text-xs text-stone-600">Vitamin C (mg)</label>
                                        <input type="number" @bind="ViewingMeal.VitaminC" class="bg-stone-50 border border-stone-300 px-2 py-1.5 text-sm focus:outline-none focus:border-emerald-950 rounded-sm shadow-inner" />
                                    </div>
                                    <div class="flex flex-col space-y-1">
                                        <label class="text-xs text-stone-600">Vitamin D (mcg)</label>
                                        <input type="number" @bind="ViewingMeal.VitaminD" class="bg-stone-50 border border-stone-300 px-2 py-1.5 text-sm focus:outline-none focus:border-emerald-950 rounded-sm shadow-inner" />
                                    </div>
                                    <div class="flex flex-col space-y-1">
                                        <label class="text-xs text-stone-600">Vitamin E (mg)</label>
                                        <input type="number" @bind="ViewingMeal.VitaminE" class="bg-stone-50 border border-stone-300 px-2 py-1.5 text-sm focus:outline-none focus:border-emerald-950 rounded-sm shadow-inner" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-8 flex justify-end gap-4 border-t border-stone-200 pt-4">
                            <button @onclick="() => IsEditingMode = false" class="text-stone-500 px-4 py-2 text-xs font-bold uppercase tracking-widest hover:text-emerald-950 transition-colors">Cancel</button>
                            <button @onclick="SaveChanges" class="bg-emerald-950 text-stone-50 px-6 py-2 text-xs font-bold uppercase tracking-widest hover:bg-emerald-800 transition-colors shadow-sm rounded-sm">
                                Apply Changes
                            </button>
                        </div>
                    }
                </div>
            </div>
        }

    </Authorized>
    <NotAuthorized>
        <div class="min-h-[50vh] flex flex-col items-center justify-center text-center px-6">
            <h2 class="text-emerald-950 text-3xl font-bold mb-4" style="font-family: 'Playfair Display', serif;">Access Denied</h2>
            <p class="text-stone-600 mb-8" style="font-family: 'Montserrat', sans-serif;">Please log in to manage your nutrition records.</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string? GlobalError = null;
    private CreateMealViewModel NewMealModel = new CreateMealViewModel();
    private PagedMealsViewModel? PagedResponse = null;
    private MealItemViewModel? ViewingMeal = null;
    private MealItemViewModel? OriginalMeal = null;
    
    private bool IsCompactView = true;
    private bool IsAddModalOpen = false;
    private bool IsViewModalOpen = false;
    private bool IsEditingMode = false;

    private int PageSize = 10;

    [SupplyParameterFromQuery(Name = "Page")]
    public int? CurrentPage { get; set; }

    private readonly Dictionary<string, int> AvailableMealTypes = new Dictionary<string, int>()
    {
        { "Breakfast", 1 << 0 }, { "Lunch", 1 << 1 }, { "Dinner", 1 << 2 },
        { "Late Night", 1 << 3 }, { "Snack", 1 << 4 }, { "Break", 1 << 5 },
        { "Clean", 1 << 6 }, { "Heavy", 1 << 7 }
    };

    protected override async Task OnInitializedAsync()
    {
        if (CurrentPage is null)
        {
            CurrentPage = 1;
        }

        await LoadMeals();
    }

    private async Task LoadMeals()
    {
        GlobalError = null;
        try
        {
            PagedResponse = await Http.GetFromJsonAsync<PagedMealsViewModel>($"/meals/queries/get-paged-meals?PageIndex={CurrentPage}&PageSize={PageSize}");
        }
        catch (Exception)
        {
            GlobalError = "Failed to load records. Please try again.";
        }
    }

    private string GetTagStyle(string tagName)
    {
        return tagName switch
        {
            "Breakfast" => "bg-amber-50 border border-amber-200 text-amber-800",
            "Lunch" => "bg-emerald-50 border border-emerald-200 text-emerald-800",
            "Dinner" => "bg-indigo-50 border border-indigo-200 text-indigo-800",
            "Late Night" => "bg-stone-800 border border-stone-900 text-stone-200",
            "Snack" => "bg-orange-50 border border-orange-200 text-orange-800",
            "Break" => "bg-teal-50 border border-teal-200 text-teal-800",
            "Clean" => "bg-cyan-50 border border-cyan-200 text-cyan-800",
            "Heavy" => "bg-rose-50 border border-rose-200 text-rose-800",
            _ => "bg-stone-100 border border-stone-200 text-stone-600"
        };
    }

    private void OpenAddModal()
    {
        NewMealModel = new CreateMealViewModel { InTakeTime = DateTime.Now }; 
        IsAddModalOpen = true;
    }

    private void ToggleAddMealType(int typeValue, object? isCheckedObj)
    {
        if (isCheckedObj is not null) 
        {
            NewMealModel.MealType |= typeValue;
        }
        else 
        {
            NewMealModel.MealType &= ~typeValue;
        } 
    }

    private async Task CreateMeal()
    {
        GlobalError = null;

        HttpResponseMessage response = await Http.PostAsJsonAsync("/meals/commands/create-meal", NewMealModel);
        if (response.IsSuccessStatusCode)
        {
            CloseModals();
            await LoadMeals();
        }
        else 
        {
            await HandleErrorResponse(response);
        }
    }

    private void OpenViewModal(MealItemViewModel meal)
    {
        OriginalMeal = JsonSerializer.Deserialize<MealItemViewModel>(System.Text.Json.JsonSerializer.Serialize(meal));
        ViewingMeal = JsonSerializer.Deserialize<MealItemViewModel>(System.Text.Json.JsonSerializer.Serialize(meal));
        IsViewModalOpen = true;
        IsEditingMode = false;
    }

    private void ToggleEditMealType(int typeValue, object? isCheckedObj)
    {
        if (ViewingMeal is null) 
        {
            return;
        }

        if (isCheckedObj is not null) 
        {
            ViewingMeal.MealType |= typeValue;
        }
        else 
        {
            ViewingMeal.MealType &= ~typeValue;
        }
    }

    private async Task SaveChanges()
    {
        if (ViewingMeal is null || OriginalMeal is null) 
        {
            return;
        }

        GlobalError = null;
        bool changesMade = false;
        try
        {
            if (ViewingMeal.MealName != OriginalMeal.MealName)
            {
                ChangeMealNameViewModel model = new ChangeMealNameViewModel { 
                    Id = ViewingMeal.Id, 
                    MealName = ViewingMeal.MealName 
                };

                HttpResponseMessage res = await Http.PutAsJsonAsync("/meals/commands/change-meal-name", model);
                if (!res.IsSuccessStatusCode) 
                {
                    await HandleErrorResponse(res);
                }
                else 
                {
                    changesMade = true;
                }
            }

            if (ViewingMeal.MealDetails != OriginalMeal.MealDetails)
            {
                ChangeMealDetailsViewModel model = new ChangeMealDetailsViewModel { 
                    Id = ViewingMeal.Id, 
                    MealDetails = ViewingMeal.MealDetails 
                };

                HttpResponseMessage res = await Http.PutAsJsonAsync("/meals/commands/change-meal-details", model);
                if (!res.IsSuccessStatusCode) 
                {
                    await HandleErrorResponse(res);
                }
                else 
                {
                    changesMade = true;
                }
            }

            if (ViewingMeal.MealType != OriginalMeal.MealType)
            {
                ChangeMealTypeViewModel model = new ChangeMealTypeViewModel { 
                    Id = ViewingMeal.Id, 
                    MealType = ViewingMeal.MealType 
                };

                HttpResponseMessage res = await Http.PutAsJsonAsync("/meals/commands/change-meal-type", model);
                if (!res.IsSuccessStatusCode) 
                {
                    await HandleErrorResponse(res);
                }
                else 
                {
                    changesMade = true;
                }
            }

            if (MacrosChanged())
            {
                ChangeMealNutrientsViewModel model = new ChangeMealNutrientsViewModel
                {
                    Id = ViewingMeal.Id,
                    MealName = ViewingMeal.MealName,
                    MealDetails = ViewingMeal.MealDetails,
                    MealType = ViewingMeal.MealType,
                    InTakeTime = ViewingMeal.InTakeTime,
                    Calorie = ViewingMeal.Calorie,
                    Carbohydrate = ViewingMeal.Carbohydrate,
                    Protein = ViewingMeal.Protein,
                    Fat = ViewingMeal.Fat,
                    Calcium = ViewingMeal.Calcium,
                    Iron = ViewingMeal.Iron,
                    Magnesium = ViewingMeal.Magnesium,
                    Zinc = ViewingMeal.Zinc,
                    VitaminA = ViewingMeal.VitaminA,
                    VitaminB = ViewingMeal.VitaminB,
                    VitaminC = ViewingMeal.VitaminC,
                    VitaminD = ViewingMeal.VitaminD,
                    VitaminE = ViewingMeal.VitaminE
                };

                HttpResponseMessage res = await Http.PutAsJsonAsync("/meals/commands/change-meal-nutrient", model);
                if (!res.IsSuccessStatusCode) 
                {
                    await HandleErrorResponse(res);
                }
                else 
                {
                    changesMade = true;
                }
            }

            if (changesMade && GlobalError == null)
            {
                CloseModals();
                await LoadMeals();
            }
        }
        catch (Exception)
        {
            GlobalError = "A network error occurred while updating the meal.";
        }
    }

    private bool MacrosChanged()
    {
        return ViewingMeal!.Calorie != OriginalMeal!.Calorie || ViewingMeal.Carbohydrate != OriginalMeal.Carbohydrate ||
               ViewingMeal.Protein != OriginalMeal.Protein || ViewingMeal.Fat != OriginalMeal.Fat ||
               ViewingMeal.Calcium != OriginalMeal.Calcium || ViewingMeal.Iron != OriginalMeal.Iron ||
               ViewingMeal.Magnesium != OriginalMeal.Magnesium || ViewingMeal.Zinc != OriginalMeal.Zinc ||
               ViewingMeal.VitaminA != OriginalMeal.VitaminA || ViewingMeal.VitaminB != OriginalMeal.VitaminB ||
               ViewingMeal.VitaminC != OriginalMeal.VitaminC || ViewingMeal.VitaminD != OriginalMeal.VitaminD ||
               ViewingMeal.VitaminE != OriginalMeal.VitaminE || ViewingMeal.InTakeTime != OriginalMeal.InTakeTime;
    }

    private async Task DeleteMeal(Guid id)
    {
        HttpRequestMessage request = new HttpRequestMessage(HttpMethod.Delete, "/meals/commands/delete-meal")
        {
            Content = JsonContent.Create(new { Id = id })
        };

        HttpResponseMessage response = await Http.SendAsync(request);
        if (response.IsSuccessStatusCode) 
        {
            await LoadMeals();
        }
        else
        {
            await HandleErrorResponse(response);
        }
    }

    private void CloseModals()
    {
        IsAddModalOpen = false;
        IsViewModalOpen = false;
        IsEditingMode = false;
        ViewingMeal = null;
        OriginalMeal = null;
    }

    private IEnumerable<string> GetActiveTags(int mealTypeVal)
    {
        return AvailableMealTypes
            .Where(kvp => (mealTypeVal & kvp.Value) == kvp.Value)
            .Select(kvp => kvp.Key);
    }

    private async Task NextPage() 
    { 
        if (CurrentPage < PagedResponse?.TotalPage) 
        { 
            Navigation.NavigateTo($"/dashboard?page={CurrentPage + 1}");
        } 
    }

    private async Task PrevPage() 
    {
        if (CurrentPage > 1) 
        { 
            Navigation.NavigateTo($"/dashboard?page={CurrentPage - 1}");
        }
    }

    private async Task HandleErrorResponse(HttpResponseMessage response)
    {
        ErrorMessage? error = await response.Content.ReadFromJsonAsync<ErrorMessage>();
        GlobalError = error?.Message ?? "An unexpected logic error occurred.";
    }
}