@page "/login"
@rendermode InteractiveWebAssembly

@using Cal2CapBlazor.Presentation.Client.DataTransferObjects
@using Cal2CapBlazor.Presentation.Client.Infrastructure
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<h3>Login</h3>
@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <p style="color:red">@ErrorMessage</p>
}

<div>
    <label>Email:</label>
    <input type="email" @bind="Model.EmailAddress" />
</div>
<div>
    <label>Password:</label>
    <input type="password" @bind="Model.Password" />
</div>
<button @onclick="HandleLogin">Sign In</button>

@code {
    private LoginViewModel Model = new();
    private string ErrorMessage = "";

    private async Task HandleLogin()
    {
        var response = await Http.PostAsJsonAsync("/accounts/commands/login", Model);

        if (response.IsSuccessStatusCode)
        {
            var dto = await response.Content.ReadFromJsonAsync<AccountProfileView>();
            if (dto != null)
            {
                ((WasmAuthenticationStateProvider)AuthStateProvider).UpdateState(dto);
            }
            Navigation.NavigateTo("/dashboard");
        } 
        else
        {
            var error = await response.Content.ReadFromJsonAsync<ErrorMessage>();
            ErrorMessage = error?.Message ?? "null";
            Console.WriteLine($"Login failed: {error?.Id}");
        }
    }
}