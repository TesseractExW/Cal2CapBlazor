@page "/logout"
@rendermode InteractiveWebAssembly

@using Cal2CapBlazor.Presentation.Client.DataTransferObjects
@using Cal2CapBlazor.Presentation.Client.Infrastructure
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<h3>Logging out...</h3>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Issue empty POST to server to clear the physical cookie
        await Http.PostAsync("/accounts/commands/logout", null);

        // Reset the client-side state to anonymous
        ((WasmAuthenticationStateProvider)AuthStateProvider).UpdateState(new AccountProfileView());
        
        Navigation.NavigateTo("/login");
    }
}