@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

@rendermode InteractiveWebAssembly

<nav class="bg-stone-50 w-[calc(100%-2rem)] sticky top-0 z-50 shadow-lg m-4 rounded-md">
    <div class="w-full px-4 md:px-8 lg:px-12">
        <div class="grid grid-cols-2 xl:grid-cols-3 h-[4.25rem] items-center">
            
            <div class="hidden xl:flex justify-start space-x-8 md:space-x-12 items-center" style="font-family: 'Montserrat', sans-serif;">
                <NavLink href="/" Match="NavLinkMatch.All" class="text-emerald-950 text-lg font-medium tracking-wider relative group py-2">
                    Home
                    <span class="absolute -bottom-1 left-1/2 w-0 h-[1.5px] bg-emerald-950 transition-all duration-300 ease-in-out group-hover:w-full group-hover:left-0"></span>
                </NavLink>
                
                <NavLink href="/about" class="text-emerald-950 text-lg font-medium tracking-wider relative group py-2">
                    About
                    <span class="absolute -bottom-1 left-1/2 w-0 h-[1.5px] bg-emerald-950 transition-all duration-300 ease-in-out group-hover:w-full group-hover:left-0"></span>
                </NavLink>

                <NavLink href="/documents" class="text-emerald-950 text-lg font-medium tracking-wider relative group py-2">
                    Documents
                    <span class="absolute -bottom-1 left-1/2 w-0 h-[1.5px] bg-emerald-950 transition-all duration-300 ease-in-out group-hover:w-full group-hover:left-0"></span>
                </NavLink>

                <NavLink href="/contacts" class="text-emerald-950 text-lg font-medium tracking-wider relative group py-2">
                    Contacts
                    <span class="absolute -bottom-1 left-1/2 w-0 h-[1.5px] bg-emerald-950 transition-all duration-300 ease-in-out group-hover:w-full group-hover:left-0"></span>
                </NavLink>
            </div>

            <div class="flex items-center justify-start xl:justify-center">
                <div class="cursor-pointer hover:opacity-80 transition-opacity duration-300">
                    <span class="text-emerald-950 font-medium text-2xl xl:text-3xl tracking-wider" style="font-family: 'Playfair Display', serif;">Cal2Cap</span>
                </div>
            </div>

            <div class="hidden xl:flex items-center justify-end space-x-8" style="font-family: 'Montserrat', sans-serif;">
                <AuthorizeView>
                    <Authorized>
                        <NavLink href="/dashboard" class="text-emerald-950 text-lg font-medium tracking-wider relative group py-2">
                            Dashboard
                            <span class="absolute -bottom-1 left-1/2 w-0 h-[1.5px] bg-emerald-950 transition-all duration-300 ease-in-out group-hover:w-full group-hover:left-0"></span>
                        </NavLink>
                        
                        <div class="relative">
                            <button @onclick="ToggleProfileMenu" @onfocusout="HideMenus" class="text-emerald-950 hover:-translate-y-0.5 transition-transform duration-300 focus:outline-none flex items-center">
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                            </button>
                            
                            @if (isProfileMenuOpen)
                            {
                                <div class="absolute space-y-1 right-0 mt-6 w-48 bg-stone-50 border border-stone-200 rounded-sm shadow-xl py-2 z-50 transition-all">
                                    <NavLink href="/settings" class="block px-4 py-2 text-sm text-emerald-950 hover:bg-stone-200 transition-colors">Settings</NavLink>
                                    <NavLink href="/logout" class="block px-4 py-2 text-sm text-emerald-950 hover:bg-stone-200 transition-colors">Sign Out</NavLink>
                                </div>
                            }
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <NavLink href="/login" class="text-emerald-950 text-lg font-medium tracking-wider relative group py-2">
                            Sign In
                            <span class="absolute -bottom-1 left-1/2 w-0 h-[1.5px] bg-emerald-950 transition-all duration-300 ease-in-out group-hover:w-full group-hover:left-0"></span>
                        </NavLink>
                    </NotAuthorized>
                </AuthorizeView>
            </div>

            <div class="xl:hidden flex items-center justify-end">
                <button @onclick="ToggleMobileMenu" class="text-emerald-950 hover:scale-110 transition-transform duration-300 focus:outline-none">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="@(isMobileMenuOpen ? "M6 18L18 6M6 6l12 12" : "M4 6h16M4 12h16M4 18h16")" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    @if (isMobileMenuOpen)
    {
        <div class="xl:hidden bg-stone-50 px-4 pt-2 pb-4 space-y-1 shadow-lg absolute w-full left-0 rounded-b-sm" style="font-family: 'Montserrat', sans-serif;">
            <NavLink href="/" Match="NavLinkMatch.All" class="text-emerald-950 block px-3 py-3 text-lg font-medium tracking-wider hover:bg-stone-200 transition-colors">Home</NavLink>
            <NavLink href="/about" class="text-emerald-950 block px-3 py-3 text-lg font-medium tracking-wider hover:bg-stone-200 transition-colors">About</NavLink>
            <NavLink href="/documents" class="text-emerald-950 block px-3 py-3 text-lg font-medium tracking-wider hover:bg-stone-200 transition-colors">Documents</NavLink>
            <NavLink href="/contacts" class="text-emerald-950 block px-3 py-3 text-lg font-medium tracking-wider hover:bg-stone-200 transition-colors">Contacts</NavLink>
            
            <AuthorizeView>
                <Authorized>
                    <NavLink href="/dashboard" class="text-emerald-950 block px-3 py-3 text-lg font-medium tracking-wider hover:bg-stone-200 transition-colors">Dashboard</NavLink>
                    
                    <div class="pt-4 pb-2 mt-2 border-t border-stone-200/50">
                        <p class="px-3 text-xs text-stone-500 uppercase tracking-widest mb-2">Account</p>
                        <NavLink href="/settings" class="text-emerald-950 block px-3 py-3 text-lg font-medium tracking-wider hover:bg-stone-200 transition-colors">Settings</NavLink>
                        <NavLink href="/logout" class="text-emerald-950 block px-3 py-3 text-lg font-medium tracking-wider hover:bg-stone-200 transition-colors">Sign Out</NavLink>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <NavLink href="/login" class="block px-3 py-3 mt-4 text-lg font-medium tracking-wider border border-emerald-950 text-emerald-950 text-center hover:bg-emerald-950 hover:text-stone-50 transition-colors duration-300">Sign In</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    }
</nav>

@code {
    private bool isMobileMenuOpen = false;
    private bool isProfileMenuOpen = false;

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
        if (isMobileMenuOpen) isProfileMenuOpen = false; // Close profile if opening mobile
    }

    private void ToggleProfileMenu()
    {
        isProfileMenuOpen = !isProfileMenuOpen;
    }

    // Helps close the dropdown if the user clicks away (using onfocusout on the button)
    private async Task HideMenus()
    {
        // Small delay ensures links can be clicked before the menu completely vanishes
        await Task.Delay(200); 
        isProfileMenuOpen = false;
    }
}